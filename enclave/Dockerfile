# QED enclave guest (arm64). The build context is oss/, from the repository root:
#   docker build --platform linux/arm64 -f oss/enclave/Dockerfile oss/
# Base pinned by index digest (python:3.12-slim-bookworm, resolved 2026-10-04 from Docker Hub; the --platform flag
# selects the arm64 manifest from this multi-arch index). The build workflow re-resolves and records the digest.
FROM --platform=linux/arm64 python@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3

# Reproducibility: fixed timestamps, no bytecode, no pip cache.
ENV SOURCE_DATE_EPOCH=1759536000 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    QED_ENCLAVE_ACTIONS=github.commit.push

WORKDIR /src
# 1) third-party deps, hash-pinned (generated by `uv pip compile --generate-hashes`; see README).
COPY enclave/requirements.txt ./requirements.txt
RUN pip install --require-hashes --no-deps -r requirements.txt
# 2) our own code, from the build context, without resolving anything else (node's server deps stay out).
COPY core-python ./core-python
COPY node ./node
COPY enclave ./enclave
RUN pip install --no-deps ./core-python ./node ./enclave \
 && rm -rf /src /root/.cache \
 && find /usr/local -name '__pycache__' -type d -prune -exec rm -rf {} + \
 && find /usr/local -newermt "@${SOURCE_DATE_EPOCH}" -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

# /etc/hosts and loopback are set up at start by `python -m poaw_enclave` (bootstrap.py): Docker regenerates
# /etc/hosts at run time and loopback is down by default inside a Nitro Enclave.
# Absolute path: the Nitro enclave init execs the entrypoint without the image PATH (build 1 died on "python: No such file").
ENTRYPOINT ["/usr/local/bin/python", "-m", "poaw_enclave"]
